---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, newer: work[i - 1], older: work[i + 1] },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.company} description={entry.data.summary} current="work">
  <article>
    <header class="article-header">
      <a class="back" href="/#work">All work</a>
      <h1>{entry.data.company}</h1>
      <p class="article-meta">
        {entry.data.role}<br />
        {entry.data.dates}, {entry.data.location}
      </p>
      <p class="article-summary">{entry.data.summary}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <nav class="pager" aria-label="More work">
      {
        newer && (
          <a href={`/work/${newer.id}/`}>
            <span>Next role</span>
            {newer.data.company}
          </a>
        )
      }
      {
        older && (
          <a class="next" href={`/work/${older.id}/`}>
            <span>Previous role</span>
            {older.data.company}
          </a>
        )
      }
    </nav>
  </article>
</Base>
